# Reference only: the server does not load .env files automatically.
# Export variables or pass them through your MCP client's environment.
# Path to a local, ignored application configuration JSON file.
MOBILE_DEVELOPER_MCP_CONFIG_PATH=./mobile-developer-mcp.config.json

# Provider credentials remain local. Configure only the provider you use.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json
# Alternatively, a short-lived local OAuth access token can be supplied. Never
# commit this value or place it in the app configuration JSON.
# GOOGLE_OAUTH_ACCESS_TOKEN=replace-with-short-lived-token
# Application Default Credentials are also supported (for example, `gcloud auth
# application-default login`). The identity requires Android Publisher access;
# review queries also require the Google Play Console "Reply to reviews" permission.
# Vitals additionally needs the playdeveloperreporting OAuth scope and suitable
# Play Console read access. Installation statistics additionally need object-read
# access to the configured private report bucket (devstorage.read_only); no
# object is ever written by this server.
# APP_STORE_CONNECT_KEY_PATH=/absolute/path/to/AuthKey_ABC123.p8
# APP_STORE_CONNECT_KEY_ID=ABC123
# APP_STORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000
# Optional separate local credentials for Sales and Trends or Analytics when
# account roles differ. Missing values fall back to APP_STORE_CONNECT_*.
# APP_STORE_CONNECT_SALES_KEY_PATH=/absolute/path/to/AuthKey_sales.p8
# APP_STORE_CONNECT_SALES_KEY_ID=SALESKEY
# APP_STORE_CONNECT_SALES_ISSUER_ID=00000000-0000-0000-0000-000000000000
# APP_STORE_CONNECT_ANALYTICS_KEY_PATH=/absolute/path/to/AuthKey_analytics.p8
# APP_STORE_CONNECT_ANALYTICS_KEY_ID=ANALYTICSKEY
# APP_STORE_CONNECT_ANALYTICS_ISSUER_ID=00000000-0000-0000-0000-000000000000
